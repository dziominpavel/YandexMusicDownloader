# Скопируй в .env и вставь свой токен
# Как получить: см. docs/11-get-token.md (подробная инструкция для пользователей)
# Коротко: https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
YANDEX_TOKEN=your_oauth_token_here

# Куда качать
OUTPUT_DIR=./downloads

# Встраивать обложку в тег (true/false, по умолчанию true).
# false — картинки не будет, текстовые теги пишутся как обычно.
# То же самое — чекбокс «Встраивать обложку» в окне «Настройки»
# приложения (меняется без перезапуска).
EMBED_COVER=true

# ALAC в M4A перегонять во FLAC на лету через ffmpeg.exe рядом с exe (true/false)
CONVERT_M4A=true

# Сколько треков плейлиста качать параллельно (целое 1..10, по умолчанию 3)
PLAYLIST_WORKERS=3

# Размер окна в пикселях — заполняется автоматически при закрытии окна,
# вручную править не нужно. Ключей нет или значения битые — окно
# откроется 864x576.
# WINDOW_WIDTH=864
# WINDOW_HEIGHT=576

# Папка музыкальной коллекции (включая подкаталоги) для проверки на дубли:
# перед скачиванием программа ищет похожие файлы и спрашивает подтверждение.
# Пусто или не указано — проверка выключена полностью.
# Папка загрузок (OUTPUT_DIR) индексируется всегда, автоматически.
# LIBRARY_DIR=D:\Music
