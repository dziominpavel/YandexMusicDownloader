# токен и музыка — никогда в git
.env
downloads/
*.mp3
*.flac
*.m4a
*.tmp
*.artifact-*

# снепшоты чужих репо для анализа — не коммитим (7+ МБ, чужие лицензии)
references/

# python (если выберем)
__pycache__/
.venv/
*.pyc

# go (если выберем)
bin/
yamdl
*.exe

# store: release artifacts (pack-zip.ps1 output)
/dist/

# runtime: кэш индекса коллекции (создаётся рядом с exe при запуске)
library-index.json

# runtime: журнал FLAC-монитора (создаётся рядом с exe при проверках)
flac-quality.json

# runtime: диагностический лог (создаётся рядом с exe при запуске)
app.log
app.log.1

# windows resources, generated by scripts/build-windows.ps1
src/cmd/app/*.syso
assets/winres/.winres-build.json

# ide
.vscode/
.idea/

# editor backups
*~
