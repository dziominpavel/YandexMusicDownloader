# Скопируй в .env и вставь свой токен
# Как получить: см. docs/11-get-token.md (подробная инструкция для пользователей)
# Коротко: https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
YANDEX_TOKEN=your_oauth_token_here

# Куда качать
OUTPUT_DIR=./downloads

# Формат по умолчанию: flac (fallback на mp3 автоматом)
FORMAT=flac

# Не качать обложку в тег (true/false), текстовые теги все равно пишутся
SKIP_COVER=false

# ALAC в M4A перегонять во FLAC на лету через ffmpeg.exe рядом с exe (true/false)
CONVERT_M4A=true
